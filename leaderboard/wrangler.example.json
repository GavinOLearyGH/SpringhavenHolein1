{
  "name": "springhaven-hole-6",
  "main": "worker.mjs",
  "compatibility_date": "2025-12-01",
  "assets": {
    "directory": "./generated/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "springhaven-leaderboard",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
